# Copy to .env and adjust. docker-compose reads this file.
POSTGRES_USER=siem
POSTGRES_PASSWORD=siem_pw
POSTGRES_DB=siem
POSTGRES_HOST=db
POSTGRES_PORT=5432

# FastAPI
APP_SECRET=change-me-in-prod
APP_PORT=8000

# Ingestion batching (FR10 / NFR1)
BATCH_MAX_EVENTS=1000
BATCH_MAX_SECONDS=1

# Scheduler intervals (seconds)
DETECT_INTERVAL=10
PARTITION_INTERVAL=3600
ARCHIVE_INTERVAL=3600
